# Comma-separated list of frontend origins allowed by CORS (no wildcard by default).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=15
MAX_DIMENSION=8000
MAX_PIXELS=40000000
MAX_PAYLOAD_MB=10
# Analyses and recovered files are kept in a private temp dir and deleted after this many seconds.
RESULT_TTL_SECONDS=3600
# Optional path to a trained PyTorch checkpoint (requires requirements-ml.txt). Leave empty for none.
STEGO_MODEL_PATH=
